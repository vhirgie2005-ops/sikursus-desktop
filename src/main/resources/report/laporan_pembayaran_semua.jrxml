<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pembayaran" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e8bf46bc-4339-4bc6-87e2-802c5db5777a">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SIKURSUS MySQL"/>
	<parameter name="P_TANGGAL_AWAL" class="java.sql.Date">
		<defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-01-01")]]></defaultValueExpression>
	</parameter>
	<parameter name="P_TANGGAL_AKHIR" class="java.sql.Date">
		<defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-12-31")]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
            pb.id_pembayaran,
            pb.tanggal_bayar,
            pb.nominal,
            pb.metode,
            pb.status AS status_pembayaran,
            p.id_pendaftaran,
            ps.nim,
            ps.nama AS nama_peserta,
            kls.nama_kelas,
            krs.nama_kursus
        FROM pembayaran pb
        INNER JOIN pendaftaran p ON pb.id_pendaftaran = p.id_pendaftaran
        INNER JOIN peserta ps ON p.id_peserta = ps.id_peserta
        INNER JOIN kelas kls ON p.id_kelas = kls.id_kelas
        INNER JOIN kursus krs ON kls.id_kursus = krs.id_kursus
        WHERE pb.tanggal_bayar BETWEEN $P{P_TANGGAL_AWAL} AND $P{P_TANGGAL_AKHIR}
        ORDER BY pb.tanggal_bayar, pb.id_pembayaran]]>
	</queryString>
	<field name="id_pembayaran" class="java.lang.Integer"/>
	<field name="tanggal_bayar" class="java.sql.Date"/>
	<field name="nominal" class="java.math.BigDecimal"/>
	<field name="metode" class="java.lang.String"/>
	<field name="status_pembayaran" class="java.lang.String"/>
	<field name="id_pendaftaran" class="java.lang.Integer"/>
	<field name="nim" class="java.lang.String"/>
	<field name="nama_peserta" class="java.lang.String"/>
	<field name="nama_kelas" class="java.lang.String"/>
	<field name="nama_kursus" class="java.lang.String"/>
